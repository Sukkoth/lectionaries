{
  "name": "lectionaries",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run ./dist/server.js",
    "dev": "bun --watch run server.ts | jq -R -r '. as $line | try fromjson catch $line'",
    "dev:raw": "bun --watch run server.ts",
    "dev:bot": "bun --watch run src/telegram/poll.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "build": "bun build ./server.ts --target bun --outdir ./dist && cp -r data dist/",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "kenat": "^1.1.7",
    "pino": "^9.6.0",
    "postgres": "^3.4.5"
  }
}
